{
  "name": "devgnosis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun --conditions=react-server run src/db/seed.ts",
    "db:smoke": "bun --conditions=react-server run src/db/smoke.ts",
    "auth:generate": "bun x auth@latest generate --config src/lib/auth.ts --output src/db/schema/auth.ts --adapter drizzle --dialect postgresql -y"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@neondatabase/serverless": "1.2.0",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "dotenv": "18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.3.6",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
