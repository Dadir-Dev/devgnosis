# Neon PostgreSQL — set these to the current Neon branch (development by default).
# Both point at the SAME branch; only the endpoint differs.

# Direct (non-pooler) endpoint — used by drizzle-kit (generate/migrate/check/studio/seeds).
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Pooled (PgBouncer) endpoint — used by the Next.js application at runtime.
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Better Auth — generate with `bunx auth secret` (or `openssl rand -base64 32`).
# Required in production; optional in development (Better Auth uses a default).
# BETTER_AUTH_SECRET="replace-with-a-32-plus-character-secret"

# Public origin used by Better Auth for callbacks and redirects.
BETTER_AUTH_URL="http://localhost:3000"
